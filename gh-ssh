#!/usr/bin/env bash

[ -z "${DEBUG:-}" ] || set -x
set -euo pipefail

_gh_ssh_source_dir=$(dirname "${BASH_SOURCE[0]}")

_check_dependencies() {
	if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4))); then
		printf 'gh-ssh: requires Bash 4.4+ (macOS: brew install bash)\n' >&2
		return 1
	fi
	local dep
	for dep in gh jq ssh-keygen; do
		if ! command -v "$dep" >/dev/null 2>&1; then
			printf 'gh-ssh: missing %s\n' "$dep" >&2
			return 1
		fi
	done
}

# shellcheck source=scripts/gh_cmd.sh
source "$_gh_ssh_source_dir/scripts/gh_cmd.sh"
# shellcheck source=scripts/gh_op.sh
source "$_gh_ssh_source_dir/scripts/gh_op.sh"
# shellcheck source=scripts/gh_create.sh
source "$_gh_ssh_source_dir/scripts/gh_create.sh"
# shellcheck source=scripts/gh_add.sh
source "$_gh_ssh_source_dir/scripts/gh_add.sh"
# shellcheck source=scripts/gh_status.sh
source "$_gh_ssh_source_dir/scripts/gh_status.sh"

_show_help() {
	cat <<'EOF'
gh ssh — register SSH authentication and signing keys with GitHub

USAGE
  gh ssh create [--provider file|op] [--path PATH]
                [--op-account ACCOUNT] [--op-vault VAULT] [--op-item TITLE]
                [--title TITLE] [--yes]
  gh ssh add --public-key PATH [--title TITLE]
  gh ssh status [--public-key PATH]
  gh ssh status --provider op [--op-account ACCOUNT] [--op-vault VAULT]
                [--op-item TITLE] [--public-key PATH]
                [--review-days N] [--rotate-days N]

create: generate a new passphrase-protected ~/.ssh key (default), or generate
        one inside 1Password (--provider op). Never replaces an existing key.
add:    register an existing public key; does not access its private key.
status: list GitHub keys, check a public key, or review a 1Password key's age
        and registrations without reading its private key.

create prints the public key only, never the private key. The op provider
uses the active 1Password account and prompts for a vault when omitted. With
--yes, both --op-account and --op-vault are required. Organization SSO
authorization, when required, must be completed on GitHub afterward.
EOF
}

_show_version() {
	cat "$_gh_ssh_source_dir/version.txt"
}

main() {
	local cmd=${1:-}
	case $cmd in
	'' | -h | --help | help) _show_help; return ;;
	-V | --version) _show_version; return ;;
	esac
	_check_dependencies || return 1
	shift
	case $cmd in
	create) _gh_create "$@" ;;
	add) _gh_add "$@" ;;
	status) _gh_status "$@" ;;
	*) _cmd_fail "unknown command: $cmd"; _show_help >&2; return 1 ;;
	esac
}

main "$@"
